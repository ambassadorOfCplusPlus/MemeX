# Measurement output and logs. These are regenerated by the bench scripts and some run to
# megabytes; what matters from them is already distilled into STATE.md and METHODS.md.
*.log
llama.log
main.log

# Model weights and traces. A single GGUF here is 15-39 GB.
*.gguf
*.bin
*.dat
*.safetensors

# Python and editor droppings
__pycache__/
*.pyc
.venv/
.vscode/
.idea/

# Build output, if anything is ever built in this tree
build/
build-*/
*.exe
*.dll
*.obj
*.pdb

# Credentials never belong here. Listed explicitly rather than relied upon: the tokens for
# HuggingFace and Kaggle live in the standard per-user credential locations and must stay there.
kaggle.json
.kaggle/
*token*.json
.env

# Tool droppings
.playwright-mcp/
github-data/
